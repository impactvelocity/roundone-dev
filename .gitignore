# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.swc

# workflow sdk (local runs)
/.workflow-data

# local agent skills (third-party code under its own licenses, e.g. GSAP)
/.agents/

# local Claude Code config and skill links
/.claude/

# /brag launch-video runs (scratch plans, renders, share copy)
/brag-output*/

# HyperFrames working files and renders under videos/
/videos/*/.hyperframes/
/videos/*/.media/
/videos/*/snapshots/
/videos/*/renders/
/videos/*/.capture-result.json
